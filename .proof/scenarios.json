{
  "repository": "brunnojob/java-medication-schedule",
  "inputs": [
    ".proof/scenarios.json"
  ],
  "cases": [
    {
      "name": "javac -Xlint:all -Werror MedicationSchedule.java",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "javac -Xlint:all -Werror MedicationSchedule.java"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "python -m unittest discover -v -s tests",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s tests"
      ],
      "timeout": 900,
      "display": true
    }
  ]
}
